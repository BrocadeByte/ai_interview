# Use URL-safe values for database passwords because DATABASE_URL is assembled by Compose.
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Generate these independently with: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_64_character_random_secret
REFRESH_JWT_SECRET_KEY=replace_with_an_independent_64_character_secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_REUSE_GRACE_SECONDS=10
HEALTHCHECK_TIMEOUT_SECONDS=2
# Keep false only for direct HTTP deployments; set true whenever HTTPS is enabled.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

OPENAI_API_KEY=replace_with_model_api_key
OPENAI_API_BASE=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# The existing Qdrant container is joined to ai-interview-network as "qdrant".
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=knowledge_documents
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_SCORE_THRESHOLD=0.35
EMBEDDING_TIMEOUT_SECONDS=30
DASHSCOPE_API_KEY=replace_with_dashscope_api_key
RERANK_ENABLED=true
RERANK_MODEL=gte-rerank-v2
RERANK_TIMEOUT_SECONDS=20
DASHSCOPE_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RAG_DENSE_CANDIDATE_LIMIT=30
RAG_BM25_CANDIDATE_LIMIT=30
RAG_RERANK_LIMIT=8
RAG_ADJACENT_CHUNK_WINDOW=1
RAG_CONTEXT_TOKEN_BUDGET=6000

# Required only for knowledge file upload to Aliyun OSS.
ALIYUN_OSS_REGION=cn-beijing
ALIYUN_OSS_BUCKET=zhang-start
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_PREFIX=knowledge/
OSS_ACCESS_KEY_ID=replace_with_oss_access_key_id
OSS_ACCESS_KEY_SECRET=replace_with_oss_access_key_secret

# Change to 8080 when port 80 is already occupied.
HTTP_PORT=80
